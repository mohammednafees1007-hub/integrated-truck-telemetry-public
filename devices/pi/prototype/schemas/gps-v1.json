{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "accuracy_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "latitude",
    "longitude",
    "accuracy_m",
    "timestamp"
  ],
  "additionalProperties": false
}
